rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isFuncionarioAtivo(userId) {
      return request.auth != null
             && firestore.exists(/databases/(default)/documents/users/$(userId)/subusuarios/$(request.auth.uid))
             && firestore.get(/databases/(default)/documents/users/$(userId)/subusuarios/$(request.auth.uid)).data.ativo == true;
    }

    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null
                         && (request.auth.uid == userId || isFuncionarioAtivo(userId));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
